// this program:
// - inputs a term (this is expected to be a jump or the machine will fail)
// - if it is '0 then outputs 3 and loops to the start
// - if it is '1 then outputs 4 and loops to the start
// - otherwise the jump will destroy everything on the continuation stack so the program terminates

let print = <x>. [x]output. '* in

let select = <a>. <b>. 
    input<x>. 
        x; 
        0->([a]. '*); 
        1->([b]. '*)
in

((select (print 3) (print 4)); <x>. x; '*)^*
