// this program:
// - inputs a bool term (T or F)
// - if it is T then outputs Hello
// - if it is F then outputs Goodbye

let print:
    Lambda(Eps => Eps.Hello + Eps.Goodbye) 
    => 
    output(Eps => Eps.Hello + Eps.Goodbye).*
=
    <x: Eps => Eps.Hello + Eps.Goodbye>. 
        [x]output. *
in

let select:
    Lambda(Eps => output(Eps => Eps.Hello + Eps.Goodbye).*) 
    Lambda(Eps => output(Eps => Eps.Hello + Eps.Goodbye).*) 
    input(Eps => Eps.T + Eps.F)
    => 
    Lambda(Eps => output(Eps => Eps.Hello + Eps.Goodbye).*).*
= 
    <a: Eps => output(Eps => Eps.Hello + Eps.Goodbye).*>. 
    <b: Eps => output(Eps => Eps.Hello + Eps.Goodbye).*>. 
        input<x: Eps => Eps.T + Eps.F>. x; 
        T->([a]. *); 
        F->([b]. *)
in

select (print Hello) (print Goodbye); 
<x: Eps => output(Eps => Eps.Hello + Eps.Goodbye).*>. x;
*
